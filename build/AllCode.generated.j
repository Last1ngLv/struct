    call w.start()
    set i = 0
    loop
        exitwhen i == User.AmountPlaying
        set u = User.fromPlaying(i)
        if User.Local == u.handle and PlayerHero[u.id] != null and GetUnitTypeId(PlayerHero[u.id]) != 0 then
