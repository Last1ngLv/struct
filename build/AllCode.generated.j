            call .pictures[(this.user.id * .MAX_SLOTS) + 7].showPlayer(this.user.handle, isTender[this.user.id], this.camera)
            
            call this.charMOrb[0].showPlayer(this.user.toPlayer(), isTender[this.user.id], this.camera)
